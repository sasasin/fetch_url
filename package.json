{
  "name": "@sasasin/fetch-url",
  "version": "0.1.0",
  "description": "Pi extension that fetches many web pages at once by driving Playwright directly: one Chromium, one BrowserContext per URL, concurrent navigation, no MCP and no API billing.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "fetch",
    "web",
    "url",
    "scraping",
    "playwright",
    "parallel",
    "accessibility-snapshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasasin/fetch_url.git"
  },
  "bugs": {
    "url": "https://github.com/sasasin/fetch_url/issues"
  },
  "homepage": "https://github.com/sasasin/fetch_url#readme",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "fetch-core.ts",
    "selftest.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "selftest": "node selftest.mjs --concurrency 4 --mode text https://example.com/ https://news.ycombinator.com/",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  }
}
