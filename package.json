{
  "name": "@sasasin/fetch-url",
  "version": "0.1.2",
  "description": "Pi extension that fetches many web pages at once by driving Playwright directly: one Chromium, one BrowserContext per URL, concurrent navigation, no MCP and no API billing.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "fetch",
    "web",
    "url",
    "scraping",
    "playwright",
    "parallel",
    "accessibility-snapshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasasin/fetch_url.git"
  },
  "bugs": {
    "url": "https://github.com/sasasin/fetch_url/issues"
  },
  "homepage": "https://github.com/sasasin/fetch_url#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "fetch-core.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:load": "node tests/test-load.mjs",
    "selftest": "node tests/selftest.mjs --concurrency 4 --mode text https://example.com/ https://news.ycombinator.com/",
    "test": "npm run typecheck && npm run test:load",
    "check": "npm run test"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.0.0",
    "typebox": "^1.3.27",
    "typescript": "^7.0.0",
    "jiti": "2.7.0"
  }
}
